# Copy to .env.local for local development, and set the same variables in Vercel
# (Project → Settings → Environment Variables) for the deployed app.
#
# Supabase backs the shared booking store. The publishable key below is safe to
# ship in the browser bundle: row-level security only lets it INSERT a booking.
# Reading, updating and deleting require a signed-in HQ user whose email is on
# the `kodak_admins` allowlist in the database.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
